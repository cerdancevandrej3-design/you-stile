# Скопируй этот файл в `.env` и заполни реальные значения.
# `.env` уже в .gitignore и никогда не должен попадать в репозиторий.

# --- AI provider (Polza.ai) ---
POLZA_API_KEY=pza_ВАШ_КЛЮЧ_СЮДА
POLZA_BASE_URL=https://polza.ai/api/v1

# --- Telegram: уведомления владельцу о платежах и отзывах ---
TELEGRAM_BOT_TOKEN=123456789:ВАШ_ТОКЕН_БОТА
TELEGRAM_CHAT_ID=123456789

# --- YooKassa (платежи) ---
# Берутся из личного кабинета ЮKassa → Настройки → API-ключи.
YOOKASSA_SHOP_ID=ВАШ_SHOP_ID
YOOKASSA_SECRET_KEY=ВАШ_SECRET_KEY

# --- Deploy only (CI / локально на твоей машине) ---
# SSH-ключ для деплоя на VPS — положи рядом, путь в deploy.py берётся из env.
DEPLOY_SSH_KEY=C:/Users/and/.ssh/id_rsa_deploy
DEPLOY_SSH_USER=root
DEPLOY_SSH_HOST=186.246.31.126
DEPLOY_SSH_PORT=22
# Пароль от key passphrase. Лучше использовать ssh-agent, тогда оставь пустым.
DEPLOY_SSH_PASSPHRASE=
