# Copy to hermes/.env and fill. deploy.py uploads hermes/.env to the server.

POLZA_API_KEY=
HERMES_TG_TOKEN=
HERMES_TG_CHAT_ID=

# --- MAX messenger ---
# 1) Create bot via @masterbot or MAX partner platform -> token
# 2) Create channel in MAX app, add bot as admin (write posts)
# 3) Get chat_id: npx tsx hermes.ts --max-discover
HERMES_MAX_TOKEN=
HERMES_MAX_CHAT_ID=
# HERMES_MAX_API_BASE=https://platform-api2.max.ru

DRY_RUN=false
MODE=news
# Поиск фактов по выходу звезды (Polza). Sonar Pro — живой веб, без Gemini-мышления.
HERMES_SEARCH_MODEL=perplexity/sonar-pro
HERMES_VISION_MODEL=google/gemini-3.7-flash
HERMES_TEXT_MODEL=anthropic/claude-haiku-4.5
HERMES_NEWS_TEXT_MODEL=anthropic/claude-haiku-4.5
# Смотрит на фото, шутит и пишет как человек (дешевле Sonnet)
HERMES_REVIEW_MODEL=anthropic/claude-haiku-4.5
# HERMES_REVIEW_FALLBACK=google/gemini-3.5-flash-lite
HERMES_IMAGE_MODEL=openai/gpt-5.4-image-2
HERMES_WARDROBE_IMAGE_MODEL=openai/gpt-5.4-image-2
# Если GPT Image падает с INTERNAL_ERROR — запасная модель
HERMES_IMAGE_FALLBACK=seedream/5-pro-text-to-image
# Окно новостей (дней). 14 = последние две недели: звёзды, тренды, агентства, маникюр, уход
# HERMES_NEWS_MAX_AGE_DAYS=14
